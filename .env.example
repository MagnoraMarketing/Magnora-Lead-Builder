# ============================================================================
#  LinkedIn Lead Finder — environment variables
#
#  Copy to `.env.local` (Next.js) and `worker/.env` (scraper worker).
#  NEVER commit a filled-in copy of this file.
# ============================================================================

# ----------------------------------------------------------------------------
#  SUPABASE  (required by both the web app and the worker)
# ----------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
# Supabase dashboard → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key. Safe to expose to the browser — RLS protects the data.
# Supabase dashboard → Project Settings → API Keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. BYPASSES ROW LEVEL SECURITY.
# Server-side only: Vercel env vars (no NEXT_PUBLIC_ prefix) and the worker.
# Never expose this to the browser, never log it, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
#  LINKEDIN CREDENTIALS  (worker only — never set these on Vercel)
#
#  Use a dedicated account. These are read by the worker process only and are
#  never sent to the browser, returned by an API, or written to a log.
# ----------------------------------------------------------------------------

LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# ----------------------------------------------------------------------------
#  SCRAPER TUNING  (worker only — defaults are deliberately conservative)
# ----------------------------------------------------------------------------

# How many profiles are fetched at a time. Keep at 1 unless you know why not.
SCRAPER_MAX_CONCURRENCY=1

# Base delay between profile page loads, in milliseconds. Actual delay is
# randomised between this value and 2.25x it.
SCRAPER_DELAY_MS=8000

# Per-navigation timeout in milliseconds.
SCRAPER_TIMEOUT_MS=30000

# Retries for a single failed profile before it is skipped.
SCRAPER_MAX_RETRIES=3

# Hard ceiling on search result pages loaded per job.
SCRAPER_MAX_SEARCH_PAGES=10

# Pause the browser for a while after this many page loads.
SCRAPER_BREAK_EVERY_N_REQUESTS=15

# Seconds the worker sleeps between polls when the queue is empty.
SCRAPER_POLL_INTERVAL_SECONDS=10

# Run Chromium headless. Set to false only for local debugging.
SCRAPER_HEADLESS=true

# Where the LinkedIn session (cookies) is cached. Mount a volume here in
# production so the worker does not have to log in on every restart.
SCRAPER_SESSION_DIR=.session

# Identifier for this worker instance in job claims and logs.
SCRAPER_WORKER_ID=worker-1
